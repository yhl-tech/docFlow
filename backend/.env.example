# 数据库（本地开发用 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./dssxz.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dssxz

# Redis（可选，不配置则跳过限流缓存）
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production-use-random-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 阿里云短信（可选）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 微信支付（可选，留空即可本地开发）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_CERT_SERIAL_NO=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=

# 支付宝（可选）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 支付回调公网地址（可选；留空则使用请求的 base_url）
PAYMENT_NOTIFY_BASE_URL=

# DeepSeek AI（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope（可选）。API_MODE: qwen | deepseek | auto（auto 优先 Qwen）
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
API_MODE=auto

# 服务器
# 前端开发默认请求 http://localhost:8000。uvicorn 的 --port 决定实际监听端口。
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# 本地联调 mock 支付（须与 DEBUG=true 同时开启；生产环境务必设为 false）
ENABLE_MOCK_PAYMENT=true
