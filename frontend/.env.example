# Copy to frontend/.env.local. These values are safe defaults for local development.
# Do not put API keys here. AI, SMS, and payment secrets belong in backend/.env.

# Open Graph URL in frontend/app/layout.tsx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser API origin in development (frontend/lib/api/instance.ts and frontend/lib/api/ai.ts).
# Production builds call the same origin under the /docFlow base path instead.
NEXT_PUBLIC_API_URL_DEV=http://localhost:8000

# Destination for the /api rewrite in frontend/next.config.mjs during `next dev`.
# `output: 'export'` means this rewrite is not applied to a static production export.
BACKEND_URL=http://localhost:8000
